/*+ exports */
SELECT SUM(ok) AS passed, COUNT(*) AS checks,
       CASE WHEN SUM(ok) = COUNT(*) THEN 'true' ELSE 'false' END AS footprint_ok
FROM (
  SELECT CASE WHEN COUNT(*) = 0 THEN 1 ELSE 0 END AS ok
  FROM aws.ec2.security_group_rules
  WHERE region = '{{ region }}'
  AND group_id = '{{ security_group_id }}'
  AND is_egress = 0 AND from_port = 22 AND cidr_ipv_4 = '0.0.0.0/0'
  UNION ALL
  SELECT CASE WHEN COUNT(*) = 1 THEN 1 ELSE 0 END
  FROM aws.ec2.tags
  WHERE region = '{{ region }}'
  AND resource_id = '{{ instance_id }}'
  AND key = 'owner'
  UNION ALL
  SELECT CASE WHEN COUNT(*) = 1 THEN 1 ELSE 0 END
  FROM cloudflare.dns.zones_dns_records
  WHERE zone_id = '{{ zone_id }}'
  AND name = '{{ host }}.{{ domain }}' AND type = 'A' AND content = '{{ public_ip }}'
) checks
