# Deck exports and reference material kept out of the repo
/ref

# Credentials
.env
.env.*
!.env.example

# Prebuilt binaries dropped in for the demo (auditron, stackql-agent, ...)
/bin/

# Rust
/embedded/target/
/embedded/**/target/
*.mcpb

# stackql-deploy / stackql local state
stackql-deploy.log
/stacks/**/*.log

# Evidence and scratch output from demo runs
/out/
*.zip

# Act 1 output files (primer/exec.sh) and the server log (primer/srv.sh)
/repos.jsonl
/runs.csv
/repos.psv
/stackql-srv.log

# Act 1 reference apps
node_modules/
package-lock.json
__pycache__/
.venv/

# stackql local state when run from inside the repo (Windows builds default the approot to cwd)
.stackql/
readline
stackql.log

# Leftovers from the pre-rename crate checkout (build artefacts, talk scratch)
/target/
/tmp/
