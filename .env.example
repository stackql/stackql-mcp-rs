# Copy to .env and fill in. .env is gitignored.
# The headline demo (service-footprint) needs AWS + Cloudflare + Anthropic.
# The GitHub path (golden-path) runs reads with zero credentials.

# ---- GitHub (golden-path stack and `steward --policy golden-path`; reads work with no token) ----
# A classic PAT (repo, read:org) or a fine-grained token with Administration:
# write and Issues: write on the target repo. Reads work without it.
STACKQL_GITHUB_USERNAME=
STACKQL_GITHUB_PASSWORD=

# The repo the golden-path stack manages and `steward --policy golden-path` watches.
GITHUB_ORG=stackql
GITHUB_REPO=rust-embedded-mcp-with-stackql

# ---- Anthropic (act 3 steward, the agent) ----
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5)
# STEWARD_MODEL=claude-opus-5

# ---- AWS + Cloudflare (the service-footprint stack and steward's default policy) ----
# Standard AWS env vars are picked up by the aws and awscc providers.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
# Where the t3.micro goes: a VPC and a subnet that auto-assigns public IPs
# (the default VPC's subnets do), and an Amazon Linux 2023 AMI for the region:
#   aws ec2 describe-images --owners amazon --filters "Name=name,Values=al2023-ami-2023*-x86_64" --query "sort_by(Images,&CreationDate)[-1].ImageId" --output text
AWS_VPC_ID=
AWS_SUBNET_ID=
AWS_AMI_ID=
# Cloudflare: an API token with DNS edit on the zone, and the zone id.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# The service: host.domain is the A record the stack creates and steward watches.
DEMO_HOST=rust-demo
DEMO_DOMAIN=stackql.xyz

# ---- Embedded server overrides (normally unset) ----
# Run a stackql binary you already have instead of acquiring one.
# STACKQL_MCP_BIN=/usr/local/bin/stackql
# Extract a local .mcpb instead of downloading.
# STACKQL_MCP_BUNDLE=/path/to/stackql-mcp-darwin-universal.mcpb
