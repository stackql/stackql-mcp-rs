-- =============================================================================
-- Act 1: cloud and SaaS providers as data sources accessed via SQL (stackql shell)
-- Slides: STACKQL >>, Cloud Providers as Data Sources, How to use StackQL
-- Paste one statement at a time.
-- Prereqs: none for 1.1 to 1.7 (public GitHub data; STACKQL_GITHUB_USERNAME and
-- STACKQL_GITHUB_PASSWORD in .env lift the rate limit from 60/hour to 5000/hour).
-- 1.8 needs AWS_* and CLOUDFLARE_* from .env exported before starting the shell.
-- =============================================================================

-- 1.1  the provider is a versioned document pulled from the registry
REGISTRY PULL github;
SHOW PROVIDERS;

-- 1.2  discovery: services -> resources -> methods -> fields
SHOW SERVICES IN github LIKE 'repo%';
SHOW RESOURCES IN github.repos LIKE '%branch%';
SHOW EXTENDED METHODS IN github.repos.branches;
DESCRIBE EXTENDED github.repos.branches;

-- 1.3  the estate as rows: repos in the org by visibility and archive state
SELECT visibility, archived, COUNT(*) AS repos
FROM github.repos.repos
WHERE org = 'stackql'
GROUP BY visibility, archived;

-- 1.4  ordering and limiting (the subquery keeps ORDER BY ahead of LIMIT)
SELECT name, stars, forks
FROM (
  SELECT name, stargazers_count AS stars, forks_count AS forks
  FROM github.repos.repos
  WHERE org = 'stackql' AND archived = 0
  ORDER BY stargazers_count DESC
) t
LIMIT 5;

-- 1.5  a JOIN across two resources (two API surfaces, one query):
--      is the default branch of each key repo protected?
--      (the IN list keeps the fan-out to three calls, one per repo)
SELECT b.repo, b.name AS branch, b.protected
FROM github.repos.branches b
JOIN github.repos.repos r ON r.name = b.repo
WHERE r.org = 'stackql'
  AND b.owner = 'stackql'
  AND b.repo IN ('stackql', 'stackql-deploy', 'pystackql')
  AND b.name = r.default_branch;

-- 1.6  live operational signal (the SRE angle): the latest CI runs
SELECT name, head_branch AS branch, conclusion, substr(created_at, 1, 10) AS day
FROM (
  SELECT name, head_branch, conclusion, created_at
  FROM github.actions.workflow_runs
  WHERE owner = 'stackql' AND repo = 'stackql'
  ORDER BY created_at DESC
) t
LIMIT 5;

-- 1.7  what shipped: the latest releases
SELECT tag_name, substr(published_at, 1, 10) AS published
FROM (
  SELECT tag_name, published_at
  FROM github.repos.releases
  WHERE owner = 'stackql' AND repo = 'stackql'
  ORDER BY published_at DESC
) t
LIMIT 3;

-- 1.8  two planes in one statement (a cross-provider JOIN): which EC2 instance
--      does each A record in the zone point at? The zone is looked up by name
--      and joined to its records in a CTE (a flat three-table JOIN does not
--      plan; the CTE does), then the CTE is joined to EC2. Needs AWS and
--      Cloudflare credentials exported. The bridge into acts 2 and 3.
WITH edge AS (
  SELECT z.id AS zone_id, r.name AS record, r.content AS ip
  FROM cloudflare.zones.zones z
  LEFT JOIN cloudflare.dns.zones_dns_records r ON r.zone_id = z.id
  WHERE z.name = 'stackql.xyz'
    AND r.type = 'A'
)
SELECT e.record, e.ip, i.instance_id,
       JSON_EXTRACT(i.state, '$.name') AS state
FROM edge e
JOIN aws.ec2.instances i ON i.public_ip_address = e.ip
WHERE i.region = 'ap-southeast-2';

-- =============================================================================
-- Mutations (same verbs; run only if you want to show a write in the shell,
-- otherwise these are what stackql-deploy and steward run for you in acts 2
-- and 3). Needs a token in STACKQL_GITHUB_PASSWORD with write access to the
-- repo. The values are the repo's golden state (stacks/golden-path), so
-- running them leaves it converged.
-- =============================================================================

-- a label is an INSERT ... SELECT (the provider names the required columns)
INSERT INTO github.issues.labels (owner, repo, name, color, description)
SELECT 'stackql', 'rust-embedded-mcp-with-stackql', 'security', 'b60205', 'Security posture or vulnerability';

-- and a DELETE (steward fix or stackql-deploy build puts it back)
DELETE FROM github.issues.labels
WHERE owner = 'stackql' AND repo = 'rust-embedded-mcp-with-stackql' AND name = 'security';

-- topics are a REPLACE (the API swaps the whole set)
REPLACE github.repos.topics
SET names = '["stackql","rust","mcp","golden-path"]'
WHERE owner = 'stackql' AND repo = 'rust-embedded-mcp-with-stackql';
