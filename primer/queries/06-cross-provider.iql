-- Act 1, step 4: two planes in one statement. Which EC2 instance does each
-- A record in the zone point at? Needs AWS and Cloudflare credentials and
-- the CLOUDFLARE_ZONE_ID / AWS_REGION values below (the runbook substitutes
-- them from .env).

SELECT r.name AS record, r.content AS ip, i.instance_id, JSON_EXTRACT(i.state, '$.name') AS state
FROM cloudflare.dns.zones_dns_records r
JOIN aws.ec2.instances i ON i.public_ip_address = r.content
WHERE r.zone_id = '__CLOUDFLARE_ZONE_ID__'
  AND i.region = '__AWS_REGION__'
  AND r.type = 'A';
